{
  "name": "context-rag",
  "version": "1.0.0",
  "private": true,
  "description": "Small retrieval-augmented generation demo: chunk, embed, retrieve inside a tenant, answer only from that context.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "eval": "tsx src/eval.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "build": "tsc",
    "start:dist": "npm run build && node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "openai": "^6.39.0"
  }
}
